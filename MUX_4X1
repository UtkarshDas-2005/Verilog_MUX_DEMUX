//==================================================
// 4x1 Multiplexer - Verilog HDL
//==================================================

module mux4x1 (
    input  I0,
    input  I1,
    input  I2,
    input  I3,
    input  [1:0] S,
    output Y
);

assign Y = (S==2'b00) ? I0 :
           (S==2'b01) ? I1 :
           (S==2'b10) ? I2 :
                        I3;

endmodule

//==================================================
// 4x1 Multiplexer Testbench - Verilog HDL
//==================================================

`timescale 1ns/1ps

module mux4x1_tb;

reg I0,I1,I2,I3;
reg [1:0] S;
wire Y;

mux4x1 uut(
    .I0(I0),
    .I1(I1),
    .I2(I2),
    .I3(I3),
    .S(S),
    .Y(Y)
);

initial begin

    $dumpfile("mux4x1.vcd");
    $dumpvars(0,mux4x1_tb);

    $display("S I3 I2 I1 I0 | Y");
    $monitor("%b %b %b %b %b | %b",S,I3,I2,I1,I0,Y);

    I0=0; I1=1; I2=0; I3=1;

    S=2'b00;
    #10 S=2'b01;
    #10 S=2'b10;
    #10 S=2'b11;

    #10 $finish;

end

endmodule
