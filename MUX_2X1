//==================================================
// 2x1 Multiplexer - Verilog HDL
//==================================================

module mux2x1 (
    input  I0,
    input  I1,
    input  S,
    output Y
);

    assign Y = (S) ? I1 : I0;

endmodule

//==================================================
// 2x1 Multiplexer Testbench - Verilog HDL
//==================================================

`timescale 1ns/1ps

module mux2x1_tb;

reg I0, I1, S;
wire Y;

mux2x1 uut (
    .I0(I0),
    .I1(I1),
    .S(S),
    .Y(Y)
);

initial begin
    // Create VCD file for waveform viewing
    $dumpfile("mux2x1.vcd");
    $dumpvars(0, mux2x1_tb);

    $display("S I1 I0 | Y");
    $monitor("%b %b %b | %b", S, I1, I0, Y);

    I0=0; I1=0; S=0;
    #10 I0=0; I1=1; S=0;
    #10 I0=1; I1=0; S=0;
    #10 I0=1; I1=1; S=0;

    #10 I0=0; I1=0; S=1;
    #10 I0=0; I1=1; S=1;
    #10 I0=1; I1=0; S=1;
    #10 I0=1; I1=1; S=1;

    #10 $finish;
end

endmodule
