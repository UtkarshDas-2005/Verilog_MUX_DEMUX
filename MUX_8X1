//==================================================
// 8x1 Multiplexer - Verilog HDL
//==================================================

module mux8x1 (
    input I0,I1,I2,I3,I4,I5,I6,I7,
    input [2:0] S,
    output Y
);

assign Y = (S==3'b000) ? I0 :
           (S==3'b001) ? I1 :
           (S==3'b010) ? I2 :
           (S==3'b011) ? I3 :
           (S==3'b100) ? I4 :
           (S==3'b101) ? I5 :
           (S==3'b110) ? I6 :
                         I7;

endmodule

//==================================================
// 8x1 Multiplexer Testbench - Verilog HDL
//==================================================

`timescale 1ns/1ps

module mux8x1_tb;

reg I0,I1,I2,I3,I4,I5,I6,I7;
reg [2:0] S;
wire Y;

mux8x1 uut(
    .I0(I0),
    .I1(I1),
    .I2(I2),
    .I3(I3),
    .I4(I4),
    .I5(I5),
    .I6(I6),
    .I7(I7),
    .S(S),
    .Y(Y)
);

initial begin

    $dumpfile("mux8x1.vcd");
    $dumpvars(0,mux8x1_tb);

    $display("S | Y");
    $monitor("%b | %b",S,Y);

    I0=0;
    I1=1;
    I2=0;
    I3=1;
    I4=0;
    I5=1;
    I6=0;
    I7=1;

    S=3'b000;
    #10 S=3'b001;
    #10 S=3'b010;
    #10 S=3'b011;
    #10 S=3'b100;
    #10 S=3'b101;
    #10 S=3'b110;
    #10 S=3'b111;

    #10 $finish;

end

endmodule
